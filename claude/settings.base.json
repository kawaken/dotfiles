{
  "model": "opus",
  "effortLevel": "xhigh",
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(sleep:*)",
      "Bash(history:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(jq:*)",
      "Bash(npm view:*)",
      "Read(./**)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Read(//private/tmp/**)",
      "Edit(//private/tmp/**)",
      "Bash(cat /tmp/*)",
      "Bash(ls /tmp*)",
      "Bash(mv /tmp/*)",
      "Bash(cp /tmp/*)",
      "Bash(touch /tmp/*)",
      "Bash(mkdir /tmp/*)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Skill(update-config)"
    ],
    "deny": [
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh ssh-key delete:*)",
      "Bash(gh gpg-key delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release delete-asset:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh gist delete:*)",
      "Bash(gh org remove-member:*)",
      "Bash(gh repo remove-collaborator:*)",
      "Bash(gh variable delete:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/claude/statusline.sh"
  },
  "language": "Japanese",
  "tui": "fullscreen",
  "theme": "auto",
  "outputStyle": "Concise"
}
